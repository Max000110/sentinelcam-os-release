# =============================================================
# SentinelCam — Environment Configuration Template
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================

# --- Security / Authentication ---
JWT_SECRET_KEY=YOUR_JWT_SECRET_HERE
SENTINELCAM_ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_HERE

# --- Database ---
# SQLite (standalone/development):
DATABASE_URL=sqlite+aiosqlite:///./sentinelcam.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://sentinel:YOUR_DB_PASSWORD@localhost:5432/sentinelcam

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- STUN/TURN (Coturn) ---
COTURN_ENABLED=true
COTURN_PUBLIC_IP=YOUR_SERVER_PUBLIC_IP
COTURN_PORT=3478
COTURN_TURNS_PORT=5349
COTURN_REALM=sentinelcam.local
COTURN_STATIC_AUTH_SECRET=YOUR_TURN_SECRET_HERE
TURN_CREDENTIAL_TTL_SECONDS=86400

# --- VPS Configuration (for Docker Compose) ---
VPS_PUBLIC_IP=YOUR_SERVER_PUBLIC_IP

# --- Telegram Notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Docker Compose PostgreSQL ---
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE
