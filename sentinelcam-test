    log_pass "Consolidated report generated at ${REPORTS_DIR}/production-readiness.md"
}

case "$1" in
    unit)
        run_unit
        ;;
    integration)
        run_integration
        ;;
    webrtc|latency)
        run_webrtc_latency
        ;;
    security)
        run_security
        ;;
    resilience|chaos)
        run_resilience_chaos
        ;;
    backup|restore)
        run_backup_restore
        ;;
    stress|soak)
        run_stress_soak
        ;;
    full|"")
        run_unit
        run_integration
        run_webrtc_latency
        run_security
        run_resilience_chaos
        run_backup_restore
        run_stress_soak
        generate_final_report
        echo -e "\n${GREEN}================================================================${NC}"
        echo -e "${GREEN}🎉 ALL SENTINELCAM TEST GATES PASSED — SYSTEM IS PRODUCTION READY${NC}"
        echo -e "${GREEN}================================================================${NC}"
        ;;
    *)
        echo "Usage: $0 {full|unit|integration|webrtc|latency|security|resilience|chaos|backup|restore|stress|soak}"
        exit 1
        ;;
esac
